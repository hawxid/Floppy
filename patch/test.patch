+
+	up.vdev_id = helper->vdev_id;
+	status = wmi_unified_vdev_up_send(wma->wmi_handle, helper->mac_addr,
+					  &up);
+	if (QDF_IS_STATUS_SUCCESS(status))
+		helper->wmi_up = true;
+	return status;
+}
