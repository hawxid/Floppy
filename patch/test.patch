+		if (slot->route == WMA_INJECTION_ROUTE_DP &&
+		    wma_injection_ctx.dp_in_flight)
+			wma_injection_ctx.dp_in_flight--;
+		if (wma_injection_ctx.in_flight)
+			wma_injection_ctx.in_flight--;
+	}
+	qdf_mem_zero(slot, sizeof(*slot));
+	slot->state = WMA_INJECTION_SLOT_FREE;
