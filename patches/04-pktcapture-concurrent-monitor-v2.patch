 		cds_err("HDD context is NULL");
 		return false;
 	}
 
-	return hdd_ctx->enable_pkt_capture_support;
+	/* Force-enable: upstream never assigns enable_pkt_capture_support,
+	 * so the pkt_capture concurrent-monitor path would stay dead.
+	 * We need it active for STA + monitor VIF support. */
+	hdd_ctx->enable_pkt_capture_support = true;
+	return true;
 }
 
