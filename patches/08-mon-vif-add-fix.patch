diff --git a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_p2p.c b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_p2p.c
index b47d4b072..42d3b0299 100644
--- a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_p2p.c
+++ b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_p2p.c
@@ -671,12 +671,34 @@ struct wireless_dev *__wlan_hdd_add_virtual_intf(struct wiphy *wiphy,
 	if (QDF_IS_STATUS_ERROR(status))
 		return ERR_PTR(qdf_status_to_os_return(status));
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+	/* Treat an unflagged iw/airmon-ng monitor VIF as full RX capture
+	 * (disable BSSID filtering), same as the A73 reference tree. */
+	if (mode == QDF_MONITOR_MODE &&
+	    !(*flags & MONITOR_FLAG_OTHER_BSS))
+		*flags |= MONITOR_FLAG_OTHER_BSS;
+#endif
+
 	switch (mode) {
 	case QDF_SAP_MODE:
 	case QDF_P2P_GO_MODE:
 	case QDF_P2P_CLIENT_MODE:
 	case QDF_STA_MODE:
 		break;
+	case QDF_MONITOR_MODE:
+		/*
+		 * Allow "iw phy phy0 interface add <name> type monitor" to
+		 * create a real monitor-mode adapter instead of silently
+		 * falling back to QDF_STA_MODE. hdd_open_adapter() with
+		 * QDF_MONITOR_MODE is the same path con_mode=4 uses to
+		 * bring up its monitor interface.
+		 *
+		 * NOTE (langkah awal): no concurrency management yet — the
+		 * STA-disconnect/restore and policy checks (SAP/P2P guards)
+		 * from the full STA+monitor port are not included here.
+		 * Test with STA idle first.
+		 */
+		break;
 	default:
 		mode = QDF_STA_MODE;
 		break;
