+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+/**
+ * hdd_set_mon_adapter_ops() - net_device_ops for an iw-created monitor
+ * interface.
+ * @dev: Handle to struct net_device to be updated.
+ *
+ * An interface created via "iw ... interface add ... type monitor"
+ * (QDF_MONITOR_MODE adapter) needs the monitor net_device_ops
+ * (hdd_mon_open, which installs the monitor RX callback and enables
+ * monitor mode) even when the driver is not in global monitor mode
+ * (con_mode != 4).  Without this the interface silently gets the
+ * station ops and behaves like a broken Ethernet device.
+ *
+ * Return: None
+ */
+static void hdd_set_mon_adapter_ops(struct net_device *dev)
+{
+	dev->netdev_ops = &wlan_mon_drv_ops;
+}
+#else
+static void hdd_set_mon_adapter_ops(struct net_device *dev)
+{
+}
+#endif
