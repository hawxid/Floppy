+/**
+ * hdd_set_monitor_channel_by_freq() - Set monitor capture channel by freq
+ * @wdev: monitor interface's wireless_dev
+ * @freq: center frequency in MHz
+ *
+ * Same channel-switch machinery as wlan_hdd_cfg80211_set_mon_ch(), but
+ * callable without passing through cfg80211's interface-concurrency check:
+ * cfg80211_set_monitor_channel() refuses with -EBUSY whenever any
+ * non-monitor interface is up, which makes channel hopping (e.g. by
+ * airodump-ng) impossible while a hotspot or STA is active.  Only the
+ * monitor adapter's own channel state is changed here; concurrent
+ * interfaces keep theirs, subject to what the firmware allows on a
+ * single radio.
+ *
+ * Return: 0 on success, negative errno otherwise.
+ */
+int hdd_set_monitor_channel_by_freq(struct wireless_dev *wdev, u32 freq)
+{
+	struct wiphy *wiphy = wdev->wiphy;
+	struct ieee80211_channel *chan;
+	struct cfg80211_chan_def chandef;
+	struct osif_psoc_sync *psoc_sync;
+	int errno;
+
+	if (wdev->iftype != NL80211_IFTYPE_MONITOR)
+		return -EOPNOTSUPP;
+
+	chan = ieee80211_get_channel(wiphy, freq);
+	if (!chan)
+		return -EINVAL;
+
+	cfg80211_chandef_create(&chandef, chan, NL80211_CHAN_HT20);
+
+	errno = osif_psoc_sync_op_start(wiphy_dev(wiphy), &psoc_sync);
+	if (errno)
+		return errno;
+
+	errno = __wlan_hdd_cfg80211_set_mon_ch(wiphy, &chandef);
+
+	osif_psoc_sync_op_stop(psoc_sync);
+
+	return errno;
+}
 #endif
 
