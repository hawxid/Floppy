+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+/**
+ * hdd_wext_siwfreq() - SIOCSIWFREQ handler
+ * @dev: network device
+ * @info: ioctl request info (unused)
+ * @wrqu: ioctl data, wrqu->freq carries channel or frequency
+ * @extra: unused
+ *
+ * airodump-ng hops channels via SIOCSIWFREQ.  There is no generic handler
+ * for it: this kernel is built with CONFIG_CFG80211_WEXT disabled, and
+ * even where the cfg80211 wext compat layer exists, its siwfreq path ends
+ * in cfg80211_set_monitor_channel(), which refuses with -EBUSY while any
+ * non-monitor interface is up - making channel hopping impossible with a
+ * hotspot or STA active.
+ *
+ * This handler drives the driver's own monitor channel switch directly
+ * (the same machinery the nl80211 set_channel path uses), so a monitor
+ * interface can change channel regardless of other interfaces.  Whether
+ * the firmware honors a monitor channel different from a concurrent
+ * AP/STA's channel on this single-radio hardware is up to the firmware.
+ *
+ * Return: 0 on success, -EOPNOTSUPP for non-monitor interfaces,
+ * -EINVAL for a bogus channel/frequency.
+ */
+static int hdd_wext_siwfreq(struct net_device *dev,
+			    struct iw_request_info *info,
+			    union iwreq_data *wrqu, char *extra)
+{
+	struct wireless_dev *wdev = dev->ieee80211_ptr;
+	u32 freq;
+
+	if (!wdev || wdev->iftype != NL80211_IFTYPE_MONITOR)
+		return -EOPNOTSUPP;
+
+	if (wrqu->freq.e == 0) {
+		/* Channel number (airodump-ng / iwconfig style) */
+		int chan = wrqu->freq.m;
+
+		if (chan <= 0)
+			return -EINVAL;
+		if (chan <= 14)
+			freq = 2407 + chan * 5;
+		else
+			freq = 5000 + chan * 5;
+	} else {
+		/* Absolute frequency: m * 10^e Hz */
+		u64 hz = wrqu->freq.m;
+		int i;
+
+		for (i = 0; i < wrqu->freq.e; i++)
+			hz *= 10;
+		freq = (u32)(hz / 1000000);
+		if (!freq)
+			return -EINVAL;
+	}
+
+	return hdd_set_monitor_channel_by_freq(wdev, freq);
+}
+#endif
+
 static const iw_handler we_standard[] = {
 	[IW_IOCTL_IDX(SIOCGIWFREQ)] = (iw_handler)hdd_wext_giwfreq,
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	[IW_IOCTL_IDX(SIOCSIWFREQ)] = (iw_handler)hdd_wext_siwfreq,
+#endif
 	[IW_IOCTL_IDX(SIOCSIWMODE)] = (iw_handler)hdd_wext_siwmode,
 	[IW_IOCTL_IDX(SIOCGIWMODE)] = (iw_handler)hdd_wext_giwmode,
 };
