diff --git a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
--- a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
+++ b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
@@ -2662,6 +2662,19 @@ static int __hdd_mon_open(struct net_device *dev)
 	if (!ret)
 		ret = hdd_enable_monitor_mode(dev);
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+	/*
+	 * Mission-mode monitor VIF created via "iw ... interface add ...
+	 * type monitor" never gets hdd_init_frame_injection() called.
+	 * Patch 01 only initializes injection_ctx for adapters existing
+	 * at driver init. Without this, hdd_monitor_mode_tx_inject()
+	 * silently drops frames (adapter->injection_ctx is NULL).
+	 */
+	if (!ret && !adapter->injection_ctx) {
+		if (QDF_IS_STATUS_ERROR(hdd_init_frame_injection(adapter)))
+			hdd_err("Failed to init injection for mon VIF");
+	}
+#endif
+
 	if (!ret) {
 		hdd_set_current_throughput_level(hdd_ctx,
 						 PLD_BUS_WIDTH_VERY_HIGH);
