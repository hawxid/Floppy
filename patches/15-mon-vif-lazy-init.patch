diff --git a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
--- a/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
+++ b/drivers/staging/qcacld-3.0/core/hdd/src/wlan_hdd_main.c
@@ -9815,7 +9815,17 @@
 	uint64_t now;
 	QDF_STATUS status;
 	bool has_radiotap = false;
 
+#ifdef FEATURE_FRAME_INJECTION_SUPPORT
+	/* Lazy init for mission-mode VIF: patch 14's open-time init
+	 * doesn't run for iw-created VIFs. Init on first TX instead. */
+	if (adapter && !adapter->injection_ctx) {
+		pr_err("MONVIF: Lazy init injection for TX via %s\n",
+		       adapter->dev ? adapter->dev->name : "?");
+		if (QDF_IS_STATUS_ERROR(hdd_init_frame_injection(adapter)))
+			pr_err("MONVIF: Lazy init failed\n");
+	}
+#endif
 
 	if (!adapter || !adapter->injection_ctx || !skb)
 		goto drop;
